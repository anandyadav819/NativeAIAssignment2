{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.AspNetCore.Http.Connections": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FoodDeliveryDb": "Host=localhost;Port=5432;Database=fooddelivery;Username=postgres;Password=23rc8efwmed932d@$c83"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "Tracking:"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
